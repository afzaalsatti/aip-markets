# AIP Markets — local research demo configuration
# Copy to .env (repo root and/or backend/) as needed. Never commit real secrets.

PROJECT_NAME="AIP Markets"
VERSION="1.0.0"

# Database (SQLite default — frictionless local demo)
DATABASE_URL="sqlite+aiosqlite:///./asset_intelligence.db"

# Local LLM / Ollama
# Pull: ollama pull qwen2.5:3b
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
# false = prefer Ollama; true = always use deterministic mock synthesizer (narrative only)
USE_MOCK_LLM_FALLBACK=false

# Market data
# true = synthetic quotes (dev only) — UI should show non-live freshness
USE_MOCK_MARKET_DATA=false
YFINANCE_CACHE_TTL_MINUTES=15
# Unused in default path (no FRED integration wired)
FRED_API_KEY=""

# Frontend → API (also see frontend/.env.example for Vercel)
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# CORS — comma-separated origins (required when UI is on Vercel)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Hosted deploy without Ollama:
# USE_MOCK_LLM_FALLBACK=true
# See DEPLOY.md

# Auth — NOT implemented. These vars exist for future use only; routers are open.
SECRET_KEY="dev_only_not_used_change_if_you_add_auth"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
